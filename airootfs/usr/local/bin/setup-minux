#!/usr/bin/env bash
set -Eeuo pipefail

if (( EUID != 0 )); then
    echo "Run setup-minux as root." >&2
    exit 1
fi
config_path=/usr/share/minux.json
archinstall_args=()
while (( $# )); do
    case "$1" in
        --config)
            [[ $# -ge 2 ]] || { echo "--config requires a file" >&2; exit 2; }
            config_path=$2
            shift 2
            ;;
        --config=*) config_path=${1#*=}; shift ;;
        *) archinstall_args+=("$1"); shift ;;
    esac
done
for tool in archinstall jq; do
    command -v "$tool" >/dev/null || { echo "Missing required command: $tool" >&2; exit 1; }
done
[[ -r "$config_path" ]] || { echo "Cannot read configuration: $config_path" >&2; exit 1; }

# Run customization while archinstall still owns the mounted filesystem layout.
# This supports Btrfs, encryption and separate mounts without guessing devices,
# and finishes before archinstall offers to reboot.
custom_command=$(cat <<'MINUX_POST_INSTALL'
set -Eeuo pipefail
exec > >(tee -a /var/log/minux-install.log) 2>&1
rm -f /var/lib/minux/install-complete
pacman -Syu --needed --noconfirm git
scripts_dir=$(mktemp -d /root/minux-install.XXXXXX)
trap 'rm -rf "$scripts_dir"' EXIT
git -C "$scripts_dir" init -q
git -C "$scripts_dir" fetch --depth 1 https://github.com/kuper0201/minux_ml_scripts refs/heads/main
git -C "$scripts_dir" checkout -q --detach FETCH_HEAD
scripts_commit=$(git -C "$scripts_dir" rev-parse HEAD)
printf "Installation scripts commit: %s\n" "$scripts_commit"
"$scripts_dir/setup.sh"
install -d /var/lib/minux
printf '%s\n' "$scripts_commit" > /var/lib/minux/install-complete
MINUX_POST_INSTALL
)
# arch-chroot bind-mounts the live resolver; give it uplink DNS, not a
# loopback stub which may be unavailable in its systemd execution context.
if [[ -s /run/systemd/resolve/resolv.conf ]]; then
    ln -sfn /run/systemd/resolve/resolv.conf /etc/resolv.conf
fi
config=$(mktemp /tmp/minux-config.XXXXXX.json)
trap 'rm -f "$config"' EXIT
jq --arg command "$custom_command" '.custom_commands = ((.custom_commands // []) + [$command])' "$config_path" > "$config"
archinstall --config "$config" "${archinstall_args[@]}"
